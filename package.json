{
	"name": "@hyperapi/client",
	"version": "0.1.0-dev",
	"description": "",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/",
		"template/"
	],
	"bin": "dist/main.mjs",
	"sideEffects": false,
	"engines": {
		"node": "^22.16 || >=24"
	},
	"dependencies": {
		"@commander-js/extra-typings": "14.0.0",
		"@hyperapi/core": "github:hyperapi/core#2247920e37eda7d096dbceda30e8eb324e57ae00",
		"typescript": "6.0.3"
	},
	"optionalDependencies": {
		"@kirick/tasq": "^0.3.0",
		"tsdown": "0.22.0",
		"type-fest": "5.6.0",
		"valibot": "1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/node": "24.12.3",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.21",
		"unplugin-unused": "0.5.4",
		"vitest": "5.0.5"
	},
	"_devpack": {
		"@hyperapi/core": "../core"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --no-dts --format esm --unused --publint",
		"check": "bun run lint && bun run test:build && bun run test && bun run build",
		"test": "vitest run && bun run test:types",
		"test:build": "bun run test:build:http && bun run test:build:tasq",
		"test:build:http": "bun run src/main.ts --name=@hyper-api/test-client-http --type=http -d test/http/build test/http/src/hyper-api",
		"test:build:tasq": "bun run src/main.ts --name=@hyper-api/test-client-tasq --type=tasq --topic=test -d test/tasq/build test/tasq/src/hyper-api",
		"test:dist": "bun run build && node dist/main.mjs --name=@hyper-api/test-client-http --type=http -d test/http/build test/http/src/hyper-api",
		"test:types": "tsc -p test/http/build/tsconfig.json && tsc -p test/tasq/build/tsconfig.json && tsc -p test/http/tsconfig.json && tsc -p test/tasq/tsconfig.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/client.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/client/issues"
	},
	"homepage": "https://github.com/hyperapi/client#readme"
}
