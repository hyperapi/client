{
	"name": "@hyperapi/client",
	"version": "0.1.0-dev",
	"description": "",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": "dist/main.mjs",
	"engines": {
		"node": ">=16"
	},
	"dependencies": {
		"@commander-js/extra-typings": "^14.0.0",
		"@hyperapi/core": "github:hyperapi/core#d3ebe406e7b366e37e307a713de5a7898fe5858d"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.1",
		"@types/node": "24.12.3",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"tsdown": "0.15.12",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.4",
		"vitest": "4.1.7"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc && (cd test && tsc)",
		"test": "npm run test:vitest && bun test --coverage",
		"test:vitest": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/client.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/client/issues"
	},
	"homepage": "https://github.com/hyperapi/client#readme"
}
